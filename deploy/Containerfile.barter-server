# Containerfile.barter-server
# Alpine-based container for pre-compiled static musl binary
# Build context: deploy/ directory (binary must be pre-built)
#
# Usage:
#   cargo build -p barter-data-server --bin barter-data-server \
#     --target x86_64-unknown-linux-musl --release
#   cp target/x86_64-unknown-linux-musl/release/barter-data-server deploy/
#   podman build -f deploy/Containerfile.barter-server -t barter-server:latest deploy/

FROM alpine:3.21

# ca-certificates needed for HTTPS (OKX ctVal fetch, etc.)
RUN apk add --no-cache ca-certificates

# Create non-root user
RUN adduser -D -h /app barter
USER barter
WORKDIR /app

# Copy pre-built static binary
COPY --chown=barter:barter barter-data-server /app/barter-data-server

# Data directories created at runtime via volume mounts:
#   /data/parquet  - parquet output
#   /data/ipc      - UDS socket + heartbeat JSON

ENTRYPOINT ["/app/barter-data-server"]
