# deploy/.env.production
# Phase 1: Binance BTCUSDT-PERP only, no L2
# Copy to deploy/.env before running compose

# ── Stream config ──────────────────────────────────────────────
STREAM_VENUES=BINANCE
STREAM_ASSETS=BTC
STREAM_PERP=1
STREAM_SPOT=0
STREAM_L2=1

# ── Parquet output ─────────────────────────────────────────────
PARQUET_ENABLED=1
PARQUET_OUTPUT_DIR=/data/parquet
PARQUET_WRITE_TRADES=1
PARQUET_WRITE_EXTENDED=1
PARQUET_WRITE_L2=0
PARQUET_FLUSH_INTERVAL_SECS=120

# ── IPC (UDS on persistent volume) ────────────────────────────
UDS_ENABLED=1
UDS_PATH=/data/ipc/barter-data.sock
UDS_BUFFER=200000

# ── Heartbeat (persistent volume) ─────────────────────────────
HEARTBEAT_ENABLED=1
HEARTBEAT_FILE=/data/ipc/collector-heartbeat.json
HEARTBEAT_INTERVAL_SECS=30

# ── Logging — WARN in prod (info = ~15GB/day) ─────────────────
RUST_LOG=warn

# ── WebSocket server ───────────────────────────────────────────
WS_ADDR=127.0.0.1:9001

# ── Throttling ─────────────────────────────────────────────────
L1_THROTTLE_MS=100

# ── Disabled feeds ─────────────────────────────────────────────
ENABLE_IBKR=false
ENABLE_DERIBIT=false

# ── barter-features ───────────────────────────────────────────
BARTER_FEATURES_INPUT_DIR=/data/parquet
BARTER_FEATURES_OUTPUT_DIR=/data/features
BARTER_FEATURES_CHECKPOINT_DIR=/data/_checkpoints
BARTER_FEATURES_MODE=watch
